{
  "mcpServers": {
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@^1.0.1",
        "--headless=true",
        "--isolated=true",
        "--no-performance-crux",
        "--no-usage-statistics"
      ]
    }
  }
}
